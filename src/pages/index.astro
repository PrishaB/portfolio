---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const skills = {
  "Languages": "Python, C/C++, JavaScript, MATLAB, Verilog, SQL",
  "Frameworks & Tools": "Git, Docker, Jenkins, pytest, Linux (Bash/WSL), GCP, Jira, KiCAD",
  "Networking & Methods": "TCP/IP, IPv4/IPv6, TLS/SSL, SSH, Wireshark, Agile/Scrum",
};

const experience = [
  {
    role: "Teaching Assistant",
    org: "Purdue Electrical and Computer Engineering",
    period: "Aug 2025 – Present",
    bullets: [
      "Improved debugging outcomes for 60+ students per semester through design verification mentoring and one-on-one sessions.",
      "Diagnosed and resolved SystemVerilog logic-simulation and timing issues in lab settings.",
    ],
  },
  {
    role: "Design Lead",
    org: "Cloud Native Association at Purdue",
    period: "Aug 2025 – Present",
    bullets: [
      "Collaborated with AWS and Eli Lilly professionals to deliver monthly cloud computing workshops on Docker, Kubernetes, and serverless architecture to 20+ students.",
    ],
  },
  {
    role: "Student Exec",
    org: "Design Movement",
    period: "Jan 2025 – Present",
    bullets: [
      "Led outreach for campus events drawing 50+ attendees from multiple Midwest universities through coordinated marketing efforts.",
    ],
  },
];
---

<Layout>
  <Navbar />

  <!-- Hero -->
  <section id="hero">
    <div class="hero-content">
      <p class="eyebrow">Hi, I'm</p>
      <h1>Prisha Boreddy</h1>
      <p class="subtitle">Computer Engineering Student @ Purdue University</p>
      <p class="tagline">Concentrations in Computer Systems & Software Engineering · Minor in Creative Writing</p>
      <div class="hero-cta">
        <a href="/projects" class="btn-primary">View Projects</a>
        <a href="/#contact" class="btn-secondary">Get in Touch</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <h2>About</h2>
    <div class="about-grid">
      <div>
        <p>I'm a Computer Engineering student at Purdue University graduating December 2026, focused on building reliable systems at the intersection of hardware and software — from embedded firmware and PCB design to full-stack applications and machine learning.</p>
        <p style="margin-top:1rem">Outside of engineering, I write — my Creative Writing minor keeps me thinking about how to communicate complex ideas clearly.</p>
      </div>
      <div class="about-card">
        <div class="about-detail"><span>🎓</span><span>B.S. Computer Engineering</span></div>
        <div class="about-detail"><span>📍</span><span>Purdue University</span></div>
        <div class="about-detail"><span>📅</span><span>Graduating Dec 2026</span></div>
        <div class="about-detail"><span>✏️</span><span>Minor: Creative Writing</span></div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills">
    <h2>Skills</h2>
    <div class="skills-grid">
      {Object.entries(skills).map(([category, items]) => (
        <div class="skill-card">
          <h3>{category}</h3>
          <p>{items}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section id="experience">
    <h2>Experience</h2>
    <div class="timeline">
      {experience.map(e => (
        <div class="timeline-item">
          <div class="timeline-header">
            <div>
              <h3>{e.role}</h3>
              <p class="org">{e.org}</p>
            </div>
            <span class="period">{e.period}</span>
          </div>
          <ul>
            {e.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <section id="contact">
    <h2>Get in Touch</h2>
    <p>I'm always open to new opportunities, collaborations, or just a good conversation.</p>
    <a href="mailto:boreddy@purdue.edu" class="btn-primary">boreddy@purdue.edu</a>
  </section>

  <footer>
    <p>© 2025 Prisha Boreddy · Built with Astro</p>
  </footer>
</Layout>

<style>
  section {
    max-width: 900px;
    margin: 0 auto;
    padding: 6rem 2rem;
  }

  h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 2.5rem;
    color: #f1f5f9;
    position: relative;
    display: inline-block;
  }
  h2::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 40px;
    height: 3px;
    background: #a78bfa;
    border-radius: 2px;
  }

  /* Hero */
  #hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 2rem;
  }
  .eyebrow {
    color: #a78bfa;
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    color: #f8fafc;
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .subtitle {
    font-size: 1.25rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
  }
  .tagline {
    font-size: 0.95rem;
    color: #64748b;
    margin-bottom: 2rem;
  }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }

  .btn-primary {
    padding: 0.75rem 1.75rem;
    background: #a78bfa;
    color: #0a0a0f;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: #c4b5fd; }

  .btn-secondary {
    padding: 0.75rem 1.75rem;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    font-size: 0.95rem;
    color: #94a3b8;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-secondary:hover { border-color: #a78bfa; color: #e2e8f0; }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .about-grid p { color: #94a3b8; }
  .about-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .about-detail {
    display: flex;
    gap: 0.75rem;
    color: #94a3b8;
    font-size: 0.95rem;
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .skill-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .skill-card h3 {
    font-size: 0.85rem;
    font-weight: 600;
    color: #a78bfa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .skill-card p { color: #94a3b8; font-size: 0.9rem; }

  /* Experience */
  .timeline { display: flex; flex-direction: column; gap: 1.5rem; }
  .timeline-item {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .timeline-item h3 { font-size: 1rem; font-weight: 600; color: #f1f5f9; }
  .org { color: #a78bfa; font-size: 0.9rem; margin-top: 0.2rem; }
  .period {
    font-size: 0.8rem;
    color: #64748b;
    background: rgba(255,255,255,0.06);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    white-space: nowrap;
  }
  .timeline-item ul { padding-left: 1.25rem; }
  .timeline-item li { color: #94a3b8; font-size: 0.9rem; margin-bottom: 0.4rem; }

  /* Contact */
  #contact { text-align: center; }
  #contact p { color: #94a3b8; margin-bottom: 2rem; }

  /* Footer */
  footer {
    text-align: center;
    padding: 2rem;
    color: #334155;
    font-size: 0.85rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  @media (max-width: 640px) {
    .about-grid { grid-template-columns: 1fr; }
    .timeline-header { flex-direction: column; }
  }
</style>
