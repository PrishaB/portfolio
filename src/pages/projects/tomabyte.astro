import Navbar from '../../components/Navbar.astro';

const code0 = `#include "pico/stdlib.h"
#include "hardware/spi.h"
#include "hardware/gpio.h"
#include "chardisp.h"
#include "buzzer.h"
#include "healthbar.h"

const int SPI_OLED_SCK  = 14;
const int SPI_OLED_MOSI = 11;
const int SPI_OLED_CSn  = 13;
const int OLED_DC       = 15;
const int FEED_BUTTON   = 16;
const int PET_BUTTON    = 10;
const int CLEAN_BUTTON  = 12;

int health = 100;

int main() {
    stdio_init_all();
    init_oled_pins();
    oled_init();
    init_feed_button();
    init_pet_button();
    buzzer_init();
    init_sleepy_photoresistor();
    init_clean_button();
    healthbar_init_timer();

    animation_timer_id = add_alarm_in_ms(500, animation_callback, NULL, true);
    update_screen();

    while (true) {
        check_start_game();
        check_health();
        check_feed_button();
        check_pet_button();
        check_clean_button();
        check_reset_button();
        check_death_sound();
        check_hungry_sound();
        check_dirty_sound();
        check_sleepy_sound();
        check_sad_sound();
        check_sleep_photoresistor();
        tight_loop_contents();
    }
}`;

const code1 = `typedef enum {
    STATE_START_SCREEN, STATE_NORMAL,  STATE_HUNGRY,
    STATE_EATING,       STATE_HAPPY,   STATE_SAD,
    STATE_CLEAN,        STATE_DIRTY,   STATE_SLEEPING,
    STATE_SLEEPY,       STATE_PET,     STATE_DEAD
} PetState;

void oled_init() {
    oled_write_cmd(0xFD); oled_write_data(0x12);
    oled_write_cmd(0xAE);
    oled_write_cmd(0xB3); oled_write_data(0xF1);
    oled_write_cmd(0xCA); oled_write_data(0x7F);
    oled_write_cmd(0xA0); oled_write_data(0x74);
    oled_write_cmd(0xAF);
}

void oled_draw_sprite_scaled(uint8_t x, uint8_t y,
    const uint16_t *sprite, uint8_t w, uint8_t h, uint8_t scale) {
    for (int row = 0; row < h; row++) {
        for (int col = 0; col < w; col++) {
            uint16_t color = sprite[row * w + col];
            for (int dy = 0; dy < scale; dy++) {
                for (int dx = 0; dx < scale; dx++) {
                    uint8_t px = x + col * scale + dx;
                    uint8_t py = y + row * scale + dy;
                    oled_set_window(px, py, px, py);
                    oled_write_cmd(0x5C);
                    oled_write_data(color >> 8);
                    oled_write_data(color & 0xFF);
                }
            }
        }
    }
}

int64_t animation_callback(alarm_id_t id, void *user_data) {
    if (pet_state == STATE_START_SCREEN) {
        startscreen_frame = (startscreen_frame + 1) % 4;
        draw_start_screen_sprite();
    } else {
        walk_toggle  = !walk_toggle;
        eating_frame = (eating_frame + 1) % 4;
        draw_pet();
    }
    return 10000;
}

int64_t random_timer_callback(alarm_id_t id, void *user_data) {
    if (pet_state == STATE_NORMAL) {
        random_seed = random_seed * 1103515245 + 12345;
        random_seed ^= to_ms_since_boot(get_absolute_time());
        switch ((random_seed >> 16) % 4) {
            case 0: pet_state = STATE_HUNGRY; health -= 20; break;
            case 1: pet_state = STATE_SAD;    health -= 10; break;
            case 2: pet_state = STATE_DIRTY;  health -= 15; break;
            case 3: pet_state = STATE_SLEEPY; health -= 5;  break;
        }
        if (health <= 0)
            death_alarm_id = add_alarm_in_ms(1000, death_callback, NULL, false);
        update_screen();
    }
    return 0;
}`;

const code2 = `#define BUZZER_PIN 21

void buzzer_play(uint freq, uint time) {
    uint slice_num = pwm_gpio_to_slice_num(BUZZER_PIN);
    uint clk_freq  = clock_get_hz(clk_sys);
    float divider  = 150;
    uint wrap      = clk_freq / (divider * freq) - 1;
    pwm_set_clkdiv(slice_num, divider);
    pwm_set_wrap(slice_num, wrap);
    pwm_set_chan_level(slice_num, pwm_gpio_to_channel(BUZZER_PIN), wrap / 2);
    pwm_set_enabled(slice_num, true);
    sleep_ms(time);
    pwm_set_enabled(slice_num, false);
}

void chirp_sound()     { buzzer_play(2000,30); sleep_ms(10); buzzer_play(2500,30); }
void happy_sound()     { buzzer_play(1500,80); sleep_ms(20); buzzer_play(1800,80); sleep_ms(20); buzzer_play(2200,120); }
void sad_sound()       { for(int i=0;i<8;i++){ buzzer_play(400+(i%2)*100,80); sleep_ms(20); } }
void fart_sound()      { buzzer_play(200,100); buzzer_play(150,120); buzzer_play(100,150); }
void sleepy_sound()    { buzzer_play(300,200); sleep_ms(100); buzzer_play(200,300); }
void energized_sound() { for(int f=1000;f<=2000;f+=200) buzzer_play(f,50); }
void giggle_sound()    { for(int i=0;i<4;i++){ buzzer_play(1000+i*200,60); sleep_ms(30); } }`;

const code3 = `#ifndef BITMAP_H
#define BITMAP_H
#include <stdint.h>

extern const uint8_t  font6x8[96][6];
extern const uint16_t pet_sprite[16*16];
