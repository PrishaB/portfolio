<script>
  // Main tab switching
  document.querySelectorAll<HTMLElement>('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const target = btn.dataset.target;
      if (target) document.getElementById(target)?.classList.add('active');
    });
  });

  // File tab switching
  document.querySelectorAll<HTMLElement>('.file-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.file-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.file-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const file = btn.dataset.file;
      if (file) document.getElementById('file-' + file)?.classList.add('active');
    });
  });

  // Copy buttons
  document.querySelectorAll<HTMLElement>('.copy-btn').forEach((btn, i) => {
    btn.addEventListener('click', () => {
      const code = btn.closest('.code-card')?.querySelector('code')?.textContent ?? '';
      navigator.clipboard.writeText(code).then(() => {
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = 'Copy', 2000);
      });
    });
  });
</script>
